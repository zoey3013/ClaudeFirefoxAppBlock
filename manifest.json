{
  "manifest_version": 3,
  "name": "Anchor — Focus Blocker",
  "short_name": "Anchor",
  "version": "1.0.0",
  "description": "Block distracting sites with focus modes, schedules, shared time limits and deliberate unlocks.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "anchor-focus@local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "spanning",
  "background": {
    "scripts": [
      "src/core.js",
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "Anchor",
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/blocked/blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
