{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Anchor",
  "version": "1.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "anchor-focus@local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/zoey3013/ClaudeFirefoxAppBlock/main/updates.json"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "spanning",
  "background": {
    "scripts": [
      "src/i18n.js",
      "src/core.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/i18n.js",
        "src/core.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Anchor",
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/blocked/blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
